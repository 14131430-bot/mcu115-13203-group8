<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F8F9FA">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select Main Meal"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="16dp"/>

    <RadioGroup
        android:id="@+id/rgMainMeal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp">

        <RadioButton
            android:id="@+id/rbBurger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Burger"
            android:textSize="16sp"
            android:padding="8dp"/>

        <RadioButton
            android:id="@+id/rbFriedChicken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fried Chicken"
            android:textSize="16sp"
            android:padding="8dp"/>

        <RadioButton
            android:id="@+id/rbChickenNuggets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chicken Nuggets"
            android:textSize="16sp"
            android:padding="8dp"/>
    </RadioGroup>

    <Button
        android:id="@+id/btnMainDone"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Done"
        android:background="@drawable/bg_rounded_button"
        android:textColor="#FFFFFF"/>

</LinearLayout>
