<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F9F6FC">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Main Meal"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <RadioGroup
        android:id="@+id/rgMainMeal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp">

        <RadioButton
            android:id="@+id/rbBurger"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Burger"/>

        <RadioButton
            android:id="@+id/rbFriedChicken"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fried Chicken"/>

        <RadioButton
            android:id="@+id/rbChickenNuggets"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chicken Nuggets"/>
    </RadioGroup>

    <Button
        android:id="@+id/btnDoneMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Done"
        android:backgroundTint="#6750A4"/>

</LinearLayout>
